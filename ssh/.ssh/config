Include ~/.colima/ssh_config

# --- GitHub: ssh.github.com:443，优先走本地 SOCKS5(7890)，不通自动直连 ---
# 2026-11-16: 旧写法用内联 "nc -X 5" + Match 条件，规则未生效（写法问题，非 nc 限制）；
# 现由 ~/bin/socks5-proxy 负责：先试 7890，2 秒内不通就直连。
Host github.com
  HostName ssh.github.com
  Port 443
  User git
  ProxyCommand ~/bin/socks5-proxy %h %p
