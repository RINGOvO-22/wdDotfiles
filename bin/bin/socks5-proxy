#!/usr/bin/env python3
"""SSH ProxyCommand：先试 SOCKS5 代理，失败自动直连。

用法:   ProxyCommand ~/bin/socks5-proxy %h %p
环境:   SOCKS5_PROXY=host:port（默认 127.0.0.1:7890）
        PROTO_DEBUG=1     打开调试输出
"""
import os
import socket
import sys
import threading

TIMEOUT = 2.0


def log(*args):
    if os.environ.get("PROTO_DEBUG"):
        print("[socks5-proxy]", *args, file=sys.stderr, flush=True)


def connect_via_socks(px_host, px_port, host, port):
    """通过 SOCKS5 建立到 host:port 的隧道，失败抛 OSError。"""
    sock = socket.create_connection((px_host, px_port), timeout=TIMEOUT)

    sock.sendall(b"\x05\x01\x00")  # 版本 5，无认证
    if sock.recv(2) != b"\x05\x00":
        raise OSError("SOCKS5 握手被拒绝")

    name = host.encode()
    sock.sendall(
        b"\x05\x01\x00\x03" + bytes([len(name)]) + name + port.to_bytes(2, "big")
    )
    reply = sock.recv(4)
    if len(reply) < 2 or reply[1] != 0:
        raise OSError("SOCKS5 CONNECT 失败: %r" % reply)

    # 吃掉绑定地址，否则第一段数据会被当成地址解析
    atyp = reply[3] if len(reply) > 3 else 1
    if atyp == 1:
        sock.recv(6)
    elif atyp == 3:
        sock.recv(sock.recv(1)[0] + 2)
    elif atyp == 4:
        sock.recv(18)
    return sock


def main():
    if len(sys.argv) < 3:
        sys.exit("用法: socks5-proxy <host> <port>")

    host, port = sys.argv[1], int(sys.argv[2])
    spec = os.environ.get("SOCKS5_PROXY", "127.0.0.1:7890")

    # SOCKS5_PROXY=off 可强制直连，用于嫌代理慢或代理异常时临时绕开
    if spec.strip().lower() in ("off", "none", "direct"):
        log("proxy disabled by SOCKS5_PROXY=%s -> direct" % spec)
        sock = socket.create_connection((host, port), timeout=5)
    else:
        px = spec.split(":")
        try:
            sock = connect_via_socks(px[0], int(px[1]), host, port)
            log("via proxy", "%s:%s" % (px[0], px[1]))
        except OSError as exc:
            log("proxy failed:", exc, "-> direct")
            sock = socket.create_connection((host, port), timeout=5)

    # 连接后必须去掉握手阶段的超时，否则 SSH 会话会被 2 秒超时掐断
    sock.settimeout(None)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)

    def stdin_to_sock():
        try:
            while True:
                chunk = os.read(0, 65536)
                if not chunk:
                    break
                sock.sendall(chunk)
        except OSError:
            pass
        finally:
            try:
                sock.shutdown(socket.SHUT_WR)
            except OSError:
                pass

    threading.Thread(target=stdin_to_sock, daemon=True).start()

    try:
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            os.write(1, chunk)
    except OSError:
        pass


if __name__ == "__main__":
    main()
